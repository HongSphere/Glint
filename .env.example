# ---- GitLab ----
# 本地一般不需要：glab auth login 已配置。
# CI 中必须设置 GITLAB_TOKEN（project access token，需 api scope）。
# GITLAB_HOST=gitlab.example.com

# ---- OpenAI 兼容接口 ----
AI_BASE_URL=https://api.openai.com/v1
# 也可是 https://api.deepseek.com/v1 或内网网关
AI_API_KEY=sk-xxxx
AI_MODEL=gpt-4o-mini
# AI_TEMPERATURE=0.2
# AI_TIMEOUT=120
# AI_JSON_MODE=1
# AI_REVIEW_MAX_ISSUES=15
# AI_REVIEW_MAX_DIFF_BYTES=80000
